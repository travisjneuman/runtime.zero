#compdef rz0

_rz0() {
  local -a commands global_options managers
  commands=(
    'doctor:show privacy-safe diagnostics'
    'config:show immutable effective configuration safeguards'
    'apps:list path-free installed software'
    'cache:review bounded cache evidence without mutation'
    'leftovers:review bounded runtime.zero-owned evidence without mutation'
    'restore:restore one exact quarantine record after confirmation'
    'recovery:review bounded quarantine and restore evidence'
    'integrity:review explicit digest evidence without remediation'
    'uninstall:build a read-only finding-bound uninstall plan'
    'modules:inspect status, manifests, or lifecycle plans'
    'store:inspect or explicitly initialize the local store'
    'scan:collect bounded dry-run inventory'
    'monitor:show a one-shot native system snapshot'
    'toolchain:show Rust, AI, and developer toolchain posture'
    'report:build a privacy-reviewed local summary'
    'release:inspect a release-acceptance assessment'
    'updates:review, apply, or assess recovery for manager updates'
    'completions:print a shell completion script'
    'help:show help'
    'version:show version'
  )
  global_options=(
    '--tui:require the interactive TUI'
    '--no-tui:use the scriptable text dashboard'
    '--json:emit dashboard JSON'
    '--color:select color policy'
    '--version:show version'
    '--help:show help'
  )
  managers=(homebrew-formula homebrew-cask macports winget apt dnf pacman zypper snap flatpak)

  if (( CURRENT == 2 )); then
    _describe 'command' commands
    _describe 'global option' global_options
    return
  fi
  case $words[2] in
    completions) _values 'shell' bash zsh fish powershell ;;
    doctor|config|apps|monitor|toolchain|report) _arguments '--format[output format]:format:(text json)' '--json[JSON output]' '--help[help]' ;;
    release) _arguments '1:operation:(status)' '--assessment[bounded assessment JSON]:path:_files' '--format[output format]:format:(text json)' '--json[JSON output]' '--help[help]' ;;
    cache) _arguments '--dry-run[required report-only mode]' '*--fixture[local cache evidence JSON]:path:_files' '--plan[seal one exact dry-run quarantine plan]' '--apply[explicit quarantine apply lane]' '--path[absolute cache file]:path:_files' '--challenge-issued-unix-seconds[challenge timestamp]:timestamp:' '--confirm[exact challenge phrase]:phrase:' '--format[output format]:format:(text json)' '--json[JSON output]' '--help[help]' ;;
    leftovers) _arguments '--dry-run[required report-only mode]' '*--fixture[local leftover evidence JSON]:path:_files' '--plan[seal one exact dry-run quarantine plan]' '--apply[explicit quarantine apply lane]' '--path[absolute module-store file]:path:_files' '--challenge-issued-unix-seconds[challenge timestamp]:timestamp:' '--confirm[exact challenge phrase]:phrase:' '--format[output format]:format:(text json)' '--json[JSON output]' '--help[help]' ;;
    restore) _arguments '--dry-run[read-only exact restore plan]' '--apply[explicit restore apply lane]' '--plan-id[exact quarantine plan id]:' '--challenge-issued-unix-seconds[challenge timestamp]:timestamp:' '--confirm[exact challenge phrase]:phrase:' '--format[output format]:format:(text json)' '--json[JSON output]' '--help[help]' ;;
    recovery) _arguments '--dry-run[required read-only mode]' '--format[output format]:format:(text json)' '--json[JSON output]' '--help[help]' ;;
    integrity) _arguments '--dry-run[required report-only mode]' '*--fixture[local integrity evidence JSON]:path:_files' '--format[output format]:format:(text json)' '--json[JSON output]' '--help[help]' ;;
    scan) _arguments '--dry-run[required report-only mode]' '--include-raw-paths[local private paths]' '--format[output format]:format:(text json)' '--json[JSON output]' ;;
    uninstall) _arguments '1:operation:(plan)' '2:installed software id:' '--executable[exact manager path]:path:_files' '--format[output format]:format:(text json)' '--json[JSON output]' ;;
    modules) _arguments '1:operation:(status validate install invoke lifecycle-plan trust)' '*:manifest, package, or module id:_files' '--from[module directory]:directory:_files -/' '--store-root[store root]:directory:_files -/' '--module-id[module id]:' '--from-state[previous lifecycle state]:state:(absent staged installed_inactive active degraded quarantined)' '--to-state[next lifecycle state]:state:(absent staged installed_inactive active degraded quarantined)' '--from-version[previous module version]:' '--to-version[next module version]:' '--transition-id[exact plan transition id]:' '--developer-trial[bounded test-key-only staging or invocation]' '--signature[detached signature envelope]:path:_files' '--trusted-test-key[public test key]:path:_files' '--challenge-issued-unix-seconds[challenge timestamp]:timestamp:' '--confirm[exact challenge phrase]:phrase:' '--dry-run[required planning mode]' '--apply[developer trial apply mode]' '--format[output format]:format:(text json)' '--json[JSON output]' ;;
    store) _arguments '1:operation:(plan status init)' '--store-root[read-only store override]:directory:_files -/' '--dry-run[preview initialization]' '--yes[explicitly create scaffold]' '--format[output format]:format:(json)' '--json[JSON output]' ;;
    updates) _arguments '*--manager[manager ID]:manager:($managers)' '*--executable[exact manager path]:path:_files' '*--fixture[local evidence JSON]:path:_files' '*--manager-output[captured output]:path:_files' '--dry-run[review only]' '--probe[live availability probe]' '--allow-network-read[acknowledge metadata reads]' '--plan[build action plan]' '--queue[build serial queue]' '--apply[explicit apply lane]' '--action[exact action ID]:action:' '--all[interactive serial apply]' '--allow-network-write[acknowledge manager network writes]' '--accept-no-rollback[acknowledge manual recovery]' '--confirm[exact challenge phrase]:phrase:' '--challenge-issued-unix-seconds[challenge timestamp]:timestamp:' '--recovery-status[read-only recovery assessment]' '--transaction[exact transaction ID]:transaction:' '--format[output format]:format:(text json)' '--json[JSON output]' ;;
    *) _arguments '--help[help]' '--version[version]' '--color[color policy]:mode:(auto always never)' ;;
  esac
}

_rz0 "$@"
